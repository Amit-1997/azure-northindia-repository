{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azurenorthindiafactory"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"BlobLinkedService_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'BlobLinkedService'"
		},
		"BlobToDatalakeCopyActivity_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'BlobToDatalakeCopyActivity'"
		},
		"SinkDatalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'SinkDatalake'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azurenorthindiast.dfs.core.windows.net/"
		},
		"SinkDatalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azurenorthindiast.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azurenorthindiafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"BlobLinkedService_connectionString": {
						"value": "[parameters('BlobLinkedService_connectionString')]"
					},
					"BlobToDatalakeCopyActivity_connectionString": {
						"value": "[parameters('BlobToDatalakeCopyActivity_connectionString')]"
					},
					"SinkDatalake_accountKey": {
						"value": "[parameters('SinkDatalake_accountKey')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"SinkDatalake_properties_typeProperties_url": {
						"value": "[parameters('SinkDatalake_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}